@using U7D2D.App.ViewModels
@inject AppViewModel Vm
@inject NavigationManager Nav

<div class="mod-card @(Card.IsInstalled ? "installed" : "") @(Card.IsSelected ? "selected" : "")">
    <label class="mod-check" title="@Vm.T("card2.selectTitle")">
        <input type="checkbox" checked="@Card.IsSelected"
               @onchange="e => Card.IsSelected = e.Value is bool b && b" />
        <span class="checkmark"></span>
    </label>

    <div class="mod-main">
        <div class="mod-head">
            <div class="mod-title" title="@Card.Title">@Card.Title</div>
            <span class="badge @Card.StatusKind">@Card.StatusText</span>
        </div>

        <div class="mod-meta">
            <span class="chip">v@(Card.Version)</span>
            <span class="chip muted" title="@Card.Author">@Card.Author</span>
            <span class="chip muted">@Card.SizeLabel</span>
            <span class="chip muted">@Plurals.Files(Card.FileCount)</span>
            @if (Card.HasCode)
            {
                <span class="chip accent">DLL</span>
            }
            @if (Card.HasHarmony)
            {
                <span class="chip warn">Harmony</span>
            }
            @if (Card.ConfigCount > 0)
            {
                <span class="chip">@Card.ConfigCount XML</span>
            }
            @if (Card.IsInstalled && !string.IsNullOrWhiteSpace(Card.InstalledVersion))
            {
                <span class="chip ok">@Vm.F("card.installedAt", Card.InstalledVersion)</span>
            }
            @if (!string.IsNullOrWhiteSpace(Card.VersionNote))
            {
                <span class="chip warn" title="@Card.VersionNote">@Card.VersionNote</span>
            }
        </div>

        <p class="mod-desc @(_descExpanded ? "expanded" : "")" title="@Card.Description">@Card.Description</p>

        @if (IsLongDescription)
        {
            <button class="desc-toggle" type="button" @onclick="() => _descExpanded = !_descExpanded">
                @(_descExpanded ? Vm.T("card2.collapse") : Vm.T("card2.expand"))
            </button>
        }

        @if (Card.Package.Warning is { Length: > 0 })
        {
            <div class="inline-warning">
                <Icon Name="alert" Size="14" />
                <span>@Card.Package.Warning</span>
            </div>
        }

        <div class="mod-foot">
            <button class="file-ref" type="button"
                    title="@Vm.F("card2.openArchiveFolder", Card.ArchiveName)"
                    @onclick="() => Vm.OpenFolder(Path.GetDirectoryName(Card.Package.ArchivePath))">
                <Icon Name="folder" Size="13" />
                <span>@Card.ArchiveName</span>
            </button>
            <div class="mod-actions">
                <button class="btn ghost sm" type="button" @onclick="AnalyzeAsync" disabled="@Vm.IsAnalyzing">
                    <Icon Name="shield" Size="14" /> @Vm.T("card2.analyze")
                </button>
                <button class="btn @(Card.IsOlderVersion ? "danger" : Card.UpdateAvailable ? "accent" : "primary") sm"
                        type="button" @onclick="() => Vm.InstallOneAsync(Card)" disabled="@Card.IsInstalling">
                    <Icon Name="@(Card.UpdateAvailable ? "refresh" : "download")" Size="14" />
                    @(Card.UpdateAvailable ? Vm.T("ui.update")
                      : Card.IsOlderVersion ? Vm.T("card2.downgrade")
                      : Card.IsInstalled ? Vm.T("card2.reinstall") : Vm.T("card2.install"))
                </button>
            </div>
        </div>

        @if (Card.IsInstalling)
        {
            <div class="progress thin indeterminate"><span></span></div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ModCardViewModel Card { get; set; } = default!;

    private bool _descExpanded;

    private bool IsLongDescription => Card.Description is { Length: > 160 };

    private async Task AnalyzeAsync()
    {
        await Vm.AnalyzeCardAsync(Card);
        Nav.NavigateTo("analysis");
    }
}
